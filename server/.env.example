# Neon PostgreSQL Connection URL
DATABASE_URL=postgresql://username:password@your-neon-host/neondb?sslmode=require

# Server Port & JWT Secret
PORT=5000
JWT_SECRET=super_secret_rbss_key_2026
CLIENT_URL=http://localhost:3000

# Real SMS Gateway (Optional: Fast2SMS for sending real OTP SMS to Indian mobile numbers)
# Leave empty for instant test OTP 123456
FAST2SMS_API_KEY=your_fast2sms_api_key_here
